# 本地 GPT 调用方式：api（原供应商接口）或 codex（本机已登录的 Codex CLI）。
AI_PROVIDER=api
# 切换到 codex 无需填写 AI_API_KEY，需提前运行 codex login。
# 默认自动查找本机 Codex；找不到时填写可执行文件的绝对路径。
CODEX_BIN=
# 留空使用 Codex CLI 默认模型；可分别指定视觉/文字模型。
CODEX_MODEL=
CODEX_VISION_MODEL=
CODEX_TEXT_MODEL=
CODEX_TIMEOUT_MS=180000

# 可选。复制为 .env，填写密钥后重启服务；无密钥时仍可使用本地 OCR。
# 接口地址填写到 /v1 等基础路径，程序自动追加 /chat/completions。
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
# 截图分区、OCR 精修和几何分析使用视觉模型，需支持图片输入。
AI_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# 中文排版指令使用文字模型；留空则沿用视觉模型。
AI_TEXT_MODEL=
# 原有 SILICONFLOW_API_KEY / SILICONFLOW_BASE_URL /
# SILICONFLOW_VISION_MODEL 继续兼容；非空的 AI_* 配置优先。
