{
  "name": "slidecraft-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node build.mjs",
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/setup.mjs",
    "prestart": "node scripts/setup.mjs",
    "test": "node --test tests/*.test.mjs && node tests/smoke.cjs",
    "test:api": "node --test tests/*.test.mjs",
    "test:codex": "node tests/codex-live.cjs",
    "start:background": "node scripts/setup.mjs && node scripts/start-background.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "jszip": "3.10.1",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
